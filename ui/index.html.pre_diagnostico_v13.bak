        pbPlay:'Auto orbit (turntable)\nRotates the camera around the scene.',
        pbCamPath:'Play camera trajectory\nShows the angle, direction, and motion computed by alignment (especially useful with DPVO).',
        pbStop:'Stop the orbit.', pbSlow:'Slower.', pbFast:'Faster.',
        t4dPlay:'Play/pause the 4D sequence\nSteps through the frames imported from the folder.',
        t4dExportSeq:'Export sequence\nCopies every frame (.ply/.splat/.ksplat) to a folder you choose.',
        t4dExportPack:'Export .splat4d\nPacks the sequence into a single streaming file (only works with .splat frames — e.g. FaceAnything output).',
        t4dMode:'Playback mode\nStream: loads frame by frame (light on memory).\nGPU: uploads everything to the GPU (instant playback, uses more memory).',
        t4dConvert:'Convert to .splat\nMakes the sequence ~4x smaller and much faster to open/play (ideal for SHARP .ply output).'
      },
      ph: { title:'Import a video and click <b>Start Training</b>', hint:'The point cloud and camera path appear here before the gaussians' },
      badge: { sparse:'Sparse cloud (COLMAP)' },
      mode: { points:'⁘ Points', gs:'✴ GS', mesh:'▲ Mesh' },
      viz: { cloud:'⁘ Cloud', rings:'◍ Rings', centers:'• Centers', depthGrey:'▧ Depth grey', depthColor:'🌈 Depth color' },
      view: { free:'🎥 Free camera', front:'Front (F4)', top:'Top (F2)', right:'Right (F3)', left:'Left', back:'Back', bottom:'Bottom' },
      btn: { backEd:'← Back to editor' },
      tab: { scene:'Scene', params:'Parameters', ia:'AI Modes', log:'Log' },
      ui: { copyLog:'📋 Copy log', logCopied:'✅ Log copied', saveProject:'💾 Save project', openProject:'📂 Open project' },
      tree: {
        scene:'📁 Scene', videosNone:'🎞 Videos — <i>none</i>', pointsDash:'⁘ Sparse cloud — <i>—</i>',
        camsDash:'🎦 Cameras — <i>—</i>', splatNotGen:'✨ Splat — <i>not generated</i>',
        videosPrefix:'🎞 Videos — ', splatPrefix:'✨ Splat — ',
        pointsPrefix:'⁘ Sparse cloud — ', camsPrefix:'🎦 Cameras — ', unitPoints:' points', unitPoses:' poses'
      },
      progress: { title:'Progress', setup:'Tools (ffmpeg · COLMAP · Brush)', frames:'Frame extraction', colmap:'Camera reconstruction', train:'3DGS Training (GPU)' },
      params: {
        videosGroup:'Videos', addVideo:'＋ Add video', hint:'Start/End: hour : min : sec — leave empty to use the whole video. To cut at 10s, just type 10 in the last box · FPS: frames extracted per second', equirectHint:'360/equirectangular: choose the type on the video. The app creates 4 virtual cameras before COLMAP.',
        trainGroup:'Training', trainingEngine:'Training engine', ppispHint:'PPISP corrects exposure, vignetting, and color between frames. Requires an NVIDIA GPU, CUDA Toolkit, and Visual Studio Build Tools; it installs an isolated environment the first time.', quality:'Quality (steps)',
        frameExtraction:'Frame extraction', maxRes:'Max resolution (longer side, px)',
        maxResHint:'Resolution of the frames used for training — the single biggest factor in Gaussian sharpness. 2.5K/4K need far more VRAM and time: if you run out of memory, lower the extraction FPS (fewer frames) before lowering the resolution.',
        macToolsTitle:'macOS tools', macToolsBtn:'🍺 Open Terminal and install', macToolsRecheck:'🔄 Check again',
        macToolsHint:'Homebrew asks for an administrator password, so the install runs in the Terminal — the app opens it with the command ready. When it finishes, click Check again.',
        colmapPreset:'Alignment quality (COLMAP)',
        colmapPresetHint:'"Automatic" keeps the current COLMAP mode and changes nothing. The other options switch to the staged pipeline (extraction → matching → mapper) with more keypoints and guided verification — better alignment on fine-textured scenes, at the cost of time. Keep it on "Automatic" while comparing training results.',
        cmFeatures:'Max features per image', cmPeak:'Peak threshold (sensitivity)', cmMatcher:'Matching',
        cmGuided:'Guided matching (uses geometry to find more correspondences)',
        cmLoop:'Loop detection (video that goes around and returns to the start) — downloads ~250 MB the first time',
        cmAffine:'Affine shape (tilted cameras/drone) — forces CPU, much slower',
        cmDsp:'DSP-SIFT (scale changes and video blur) — forces CPU, much slower',
        cmBA:'Full bundle adjustment (refines focal, principal point and distortion)',
        cmMinMatches:'Minimum number of matches', cmTriAngle:'Minimum triangulation angle (°)',
        cmCustomHint:'Affine shape and DSP-SIFT have no GPU implementation in COLMAP: enabling either one pushes feature extraction to the CPU, which can multiply the time of that stage several times over. Worth it on difficult scenes, not as a default.',
        lpips:'Extra sharpness (perceptual)', lpipsHint:'Enables the LPIPS perceptual loss in the Brush engine: it compares images by what the eye perceives rather than pixel by pixel. Usually gives a noticeable jump in perceived sharpness on fine texture, but makes training slower. Brush engine on desktop only. Keep it off while comparing results — it changes the metric and contaminates the test.',
        alignGroup:'Camera alignment', alignMethod:'Method',
        dpvoMaxRes:'DPVO resolution (long side, px)', dpvoResHint:'In DPVO mode, this is also the frame resolution used for training. For maximum texture, use COLMAP at 1600/1920 px.',
        dpvoFov:'Camera field of view (DPVO)', dpvoFovHint:'DPVO does not read the real FOV from the video\'s EXIF — it assumes this value to compute the focal length. If the camera/trajectory look "wrong" (scale or proportion not matching the recorded video), a wrong value here is usually the cause: set it to the real field of view of the camera that recorded the footage.',
        alignHint:'Direct DPVO uses the local CEB package (isolated Python + Torch/CUDA), without Docker and without changing the other engines. It is much faster on long videos, but calibration is approximate (no EXIF) and the initial cloud is sparser than COLMAP\'s.', mast3rLicense:'* MASt3R and its weights are licensed CC BY-NC-SA 4.0 — non-commercial use. Check the license before commercial use or distribution.',
        editorGroup:'Editor', splatScale:'Splat scale', compact:'Save compact (removes harmonics — ~4× smaller)', cleanupOpac:'Cleanup: minimum opacity (%)',
        toolsHint:'Tools on the left bar: move, rotate, select (drag on screen), delete, crop, center, cleanup, save.',
        viewportGroup:'Viewport', pointCloud:'Point cloud', cameraPath:'Camera path',
        meshGroup:'Mesh', meshRes:'Voxel resolution', meshDensity:'Minimum density per voxel',
        meshHint:'Generates a 3D mesh from the kept points (respects crop/deletion/cleanup already done). Click the Mesh button in the viewport bar.',
        outputGroup:'Output', chooseFolder:'Choose folder…', outputDefault:'Default: Documents\\BruxoSplat',
        startBtn:'⚙️ Start Training', customStepsPlaceholder:'Number of steps'
      },
      opt: { cmAuto:'Automatic (current, safe)', cmHigh:'High — more features + guided matching', cmMax:'Maximum — DSP-SIFT + affine (very slow, CPU)', cmCustom:'Custom…', cmSeq:'Sequential (video — recommended)', cmExh:'Exhaustive (unordered photos, few images)', cmVocab:'Vocabulary tree (hundreds of unordered images)',
        engineTriangle:'Triangle Splatting — outputs a MESH (.off) instead of a splat',
        lpipsOff:'Off (default)', lpipsLow:'Light', lpipsMed:'Medium', lpipsHigh:'Strong', draft:'Draft — 7k (fast)', medium:'Medium — 15k', high:'High — 30k', max:'Maximum — 50k (slow)', ultra:'Ultra — 75k (very slow)', extreme:'Extreme — 100k (extremely slow)', customSteps:'Custom — pick a value', engineBrush:'Brush — compatible (default)', enginePpisp:'GSplat + PPISP — NVIDIA/CUDA (experimental)', alignColmap:'COLMAP (default)', alignDpvo:'Direct DPVO — fast camera tracking (local CEB package)', alignMast3r:'MASt3R — AI for difficult scenes (experimental, non-commercial*)', alignMegaSam:'MegaSam — camera + depth for dynamic scenes (experimental)', t4dStream:'Stream (light)', t4dGpu:'GPU (smooth)' },
      ia: {
        photoGroup:'Photo → 3D (SHARP)', photoHint:'A single photo becomes a 3D splat in seconds (Apple SHARP). Installs ~2 GB the first time.',
        installSharp:'⬇ Install SHARP', runSharp:'📷 Choose photo and generate',
        video4dGroup:'Video → 4D (SHARP in sequence)', video4dHint:'Extracts frames from the video and runs SHARP on each one — generates a sequence of .ply files (one splat per frame) to build the .splat4d.',
        intervalLabel:'FPS (frames extracted per second of video)', runSharp4d:'🎬 Choose video and generate sequence',
        imageGroup:'Image → 3D Asset (TripoSplat)', imageHint:'An image becomes a full 360° 3D asset (TripoSR). Installs ~4 GB the first time. Requires an NVIDIA GPU.',
        installTripo:'⬇ Install TripoSplat', runTripo:'🖼 Choose image and generate',
        faceGroup:'Video → 4D Face (FaceAnything)',
        faceHint:'Reconstructs the face in 4D from a short video (3-8s, face well framed). Generates a .splat sequence to open in WebEDIT\'s player4D. Installs ~15 GB the first time (checkpoint). Requires an NVIDIA GPU and Git installed. CC BY-NC license (non-commercial use).',
        faceMaxFrames:'Maximum frames', installFace:'⬇ Install FaceAnything', runFace:'🎭 Choose video and generate 4D face',
        footer:'Models are installed gradually, in a shared Python environment (uv).'
      },
      status: { ready:'Ready' },
      mouseHint:'LMB orbit · wheel zoom · RMB pan',
      row: { start:'start', end:'end', fps:'FPS', projection:'type', normal:'Normal video', equirect:'360 equirectangular', videoSuffix:' video(s)', trimPreview:'Preview video and mark in/out' },
      trim: { cancel:'Cancel', apply:'Apply trim', note:'Drag the green handles to mark in/out points, or click the bar to seek.', errNoVideo:'Could not load this video for preview.' },
      stage: { setup:'Preparing tools', frames:'Extracting frames', colmap:'Reconstructing cameras', train:'Training 3DGS' },
      msg: {
        processing:'Processing…', readyToTrain:'Cameras aligned ✅ — ready to train',
        alignedLog:'📐 Alignment complete. Review the cloud/path and click Start Training.',
        ready2:'Ready ✅', errorPill:'Error ❌',
        savedAtLog:'✅ Saved at: ', editorActiveLog:'🎨 Editor active: align with the gizmo, select and clean, then 💾 to save or 🌐 to open in WebEDIT.',
        errorLog:'❌ Error: ',
        cleanLog1:'🧹 Cleanup: ', cleanLog2:' gaussians removed (opacity < ', cleanLog3:'%).',
        savedFileLog:'💾 Saved: ',
        editsAppliedLog:'🔄 Edits applied: ',
        editsWarn1:'Warning: could not apply edits (', editsWarn2:')',
        generateFirst:'Generate or open a splat first.',
        loadingGS:'✴ Loading Gaussians render…', gsActive:'✴ GS mode active.', gsError:'Error in GS mode: ',
        iaMode:'AI mode…', sharp4dMode:'SHARP 4D…', face4dMode:'FaceAnything 4D…',
        openedLog:'📂 Opened: ',
        viewOnlyFormat:'ℹ️ .{fmt} file: view-only in Gaussians mode. Point editing, WebEDIT and SuperSplat only work with .ply.',
        seq4dLoaded:'🎞️ 4D sequence loaded: {n} frames.',
        seq4dCached:'✅ {n} frames cached — real-time play unlocked.',
        previewLog:'🔎 Preview: point cloud and camera path loaded in the viewport.',
        trainingPartial1:'✨ Training — partial splat (', trainingPartial2:'%)',
        buildingMesh:'▲ Generating mesh from the points…',
        meshReady:'▲ Mesh ready.',
        meshEmpty:'No kept points to build the mesh from (adjust density or undo the crop/deletion).',
        meshError:'Error generating the mesh: '
      }
    }
  };
  let curLang = 'pt';
  window.I18N = I18N;
  window.curLang = () => curLang;
  function deepGet(o, path) { return path.split('.').reduce((a, k) => (a == null ? a : a[k]), o); }
  function translate(lang) {
    curLang = lang;
    const dict = I18N[lang] || I18N.pt;
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const v = deepGet(dict, el.dataset.i18n);
      if (v != null) el.textContent = v;
    });
    document.querySelectorAll('[data-i18n-html]').forEach(el => {
      const v = deepGet(dict, el.dataset.i18nHtml);
      if (v != null) el.innerHTML = v;
    });
    document.querySelectorAll('[data-i18n-tip]').forEach(el => {
      const v = deepGet(dict, el.dataset.i18nTip);
      if (v != null) el.setAttribute('data-tip', v);
    });
    document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
      const v = deepGet(dict, el.dataset.i18nPlaceholder);
      if (v != null) el.setAttribute('placeholder', v);
    });
    $('langLbl').textContent = lang === 'pt' ? 'PT-BR' : 'ENG';
    $('btnAbort').title = $('btnAbort').ariaLabel = lang === 'en' ? 'Abort processing' : 'Abortar processamento';
    renderVideos();
    if (!running) $('sbState').textContent = dict.status.ready;
    try { localStorage.setItem('bruxoLang', lang); } catch (e) {}
    if (window.bruxo && window.bruxo.setLang) window.bruxo.setLang(lang);
    if (typeof updateTrainingEngineHint === 'function') updateTrainingEngineHint();
    // translate() reescreve o texto de todo [data-i18n], o que apaga o aviso de
    // "requer GPU NVIDIA" nas opções desabilitadas. Reaplicamos aqui (limpando o
    // marcador, senão o sufixo não seria re-adicionado no idioma novo).
    if (typeof window.__disableCudaOnlyFeatures === 'function') {
      document.querySelectorAll('option[data-cuda-note]').forEach(o => delete o.dataset.cudaNote);
      window.__disableCudaOnlyFeatures();
    }
  }
  $('btnLang').onclick = () => translate(curLang === 'pt' ? 'en' : 'pt');

  let videos = [], outDir = null, lastPly = null, lastCameraPathUrl = null, running = false, aligned = false;
  const order = ['setup','frames','colmap','train'];

  document.querySelectorAll('.tab').forEach(t => t.onclick = () => {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.tabpage').forEach(x => x.classList.remove('active'));
    t.classList.add('active'); $('pg-' + t.dataset.t).classList.add('active');
  });

  // Buffer de texto cru do log. Renderizamos a partir dele para poder
  // escapar HTML com segurança e transformar URLs em links clicáveis
  // (ex.: o link do CUDA Toolkit na mensagem de erro do nvcc).
  let logLines = [];
  const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const linkify = s => esc(s).replace(/(https?:\/\/[^\s]+?)([.,;:)]*)(?=\s|$)/g,
    (_, url, tail) => `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>${tail}`);
  const renderLog = () => {
    const el = $('log');
    el.innerHTML = logLines.map(linkify).join('\n');
    el.scrollTop = el.scrollHeight;
  };
  const log = (l, replace) => {
    if (replace) {
      const idx = logLines.length - 1;
      if (idx >= 0 && logLines[idx].startsWith('Baixando')) logLines[idx] = l;
      else logLines.push(l);
    } else logLines.push(l);
    renderLog();
  };
  document.querySelectorAll('[data-copy-log]').forEach(copyButton => copyButton.onclick = async () => {
    const text = $('log').textContent;
    if (!text.trim()) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback para instalações Electron onde a Clipboard API não está exposta.
      const area = document.createElement('textarea');
      area.value = text; area.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
      document.body.appendChild(area); area.select(); document.execCommand('copy'); area.remove();
    }
    const button = $('btnCopyLog');
    button.textContent = (I18N[curLang] || I18N.pt).ui.logCopied;
    setTimeout(() => { button.textContent = (I18N[curLang] || I18N.pt).ui.copyLog; }, 1600);
  });
  const setStage = (s, cls) => { $('st-' + s).className = 'stage ' + cls; };
  const enableStart = v => { $('btnStart').disabled = $('btnStart2').disabled = $('btnAlign').disabled = !v; };

  // ── Campos de tempo (hh/mm/ss separados) ───────────────────────────────────
  // O ffmpeg continua recebendo "hh:mm:ss" (ou string vazia = vídeo inteiro);
  // a divisão em três campos é só na interface.
  function splitTime(str) {
    const p = String(str || '').split(':');
    const pega = n => { const v = (p[n] || '').replace(/\D/g, ''); return v ? v.padStart(2, '0') : ''; };
    // Aceita também "10" solto (interpreta como segundos) para não perder dados
    // de projetos salvos por versões antigas.
    if (p.length === 1) return { h: '', m: '', s: pega(0) };
    if (p.length === 2) return { h: '', m: pega(0), s: pega(1) };
    return { h: pega(0), m: pega(1), s: pega(2) };
  }
  function joinTime(h, m, s) {
    const n = v => String(v || '').replace(/\D/g, '');
    const [H, M, S] = [n(h), n(m), n(s)];
    if (!H && !M && !S) return '';           // tudo vazio = vídeo inteiro
    const pad = v => (v || '0').padStart(2, '0');
    return pad(H) + ':' + pad(M) + ':' + pad(S);
  }

  function renderVideos() {
    const el = $('videoList');
    const t = I18N[curLang] || I18N.pt;
    el.innerHTML = '';
    videos.forEach((v, i) => {
      const row = document.createElement('div');
      row.style.cssText = 'border-bottom:1px solid var(--line);padding:6px 0';
      const name = v.path.split(/[\\\/]/).pop();
      // Três campos (hh/mm/ss) em vez de um só com "00:00:10". Assim, para cortar
      // aos 10s basta digitar 10 no último campo — sem escrever zeros nem os ":".
      const tcampos = (campo, valor) => {
        const p = splitTime(valor);
        const cx = parte => '<input class="tnum" data-f="' + campo + '" data-part="' + parte + '" data-i="' + i +
          '" inputmode="numeric" maxlength="2" placeholder="00" value="' + p[parte] + '">';
        return '<span class="tgrp"><label>' + t.row[campo] + '</label>' +
          cx('h') + '<i>:</i>' + cx('m') + '<i>:</i>' + cx('s') + '</span>';
      };
      row.innerHTML =
        '<div style="display:flex;justify-content:space-between;align-items:center">' +
        '<b style="font-size:11px">' + name + '</b>' +
        '<span><span class="trimBtn" data-trim="' + i + '" title="' + (t.row.trimPreview || 'Preview') + '">🎬</span>' +
        '<span data-del="' + i + '" style="cursor:pointer;color:var(--mut)">🗑</span></span></div>' +
        '<div class="trow">' + tcampos('start', v.start) + tcampos('end', v.end) + '</div>' +
        '<div style="display:flex;gap:4px;margin-top:4px">' +
        '<input data-f="fps" data-i="' + i + '" placeholder="' + t.row.fps + '" value="' + (v.fps || (v.interval ? String(1 / parseFloat(v.interval)) : '2')) + '" style="width:100%"></div>' +
        '<select data-f="projection" data-i="' + i + '" style="width:100%;margin-top:4px"><option value="flat"' + ((v.projection || 'flat') === 'flat' ? ' selected' : '') + '>' + t.row.normal + '</option><option value="equirect"' + (v.projection === 'equirect' ? ' selected' : '') + '>' + t.row.equirect + '</option></select>';
      el.appendChild(row);
    });
    el.querySelectorAll('[data-del]').forEach(x => x.onclick = () => { videos.splice(+x.dataset.del, 1); refreshVideos(); });
    el.querySelectorAll('[data-trim]').forEach(x => x.onclick = () => openTrimModal(+x.dataset.trim));
    // Campos hh/mm/ss: recompõem "hh:mm:ss" a partir dos três, sem re-renderizar
    // a lista (senão o foco saltaria do campo enquanto a pessoa digita).
    el.querySelectorAll('.tnum').forEach(x => {
      const recompor = () => {
        const i = x.dataset.i, campo = x.dataset.f;
        const gv = parte => (el.querySelector('.tnum[data-i="' + i + '"][data-f="' + campo + '"][data-part="' + parte + '"]') || {}).value || '';
        videos[+i][campo] = joinTime(gv('h'), gv('m'), gv('s'));
        aligned = false;
      };
      x.addEventListener('input', () => {
        x.value = x.value.replace(/\D/g, '').slice(0, 2);
        recompor();
        // Ao completar dois dígitos, pula para o próximo campo — digitar
        // "013045" preenche 01:30:45 direto.
        if (x.value.length === 2) {
          const ordem = ['h', 'm', 's'];
          const prox = ordem[ordem.indexOf(x.dataset.part) + 1];
          if (prox) el.querySelector('.tnum[data-i="' + x.dataset.i + '"][data-f="' + x.dataset.f + '"][data-part="' + prox + '"]')?.focus();
        }
      });
      // Completa com zero à esquerda ao sair (digitar "5" vira "05").
      x.addEventListener('blur', () => { if (x.value.length === 1) x.value = '0' + x.value; recompor(); });
    });
    el.querySelectorAll('[data-f]:not(.tnum)').forEach(x => x.onchange = () => { videos[+x.dataset.i][x.dataset.f] = x.value; aligned = false; });
    $('tVideo').innerHTML = t.tree.videosPrefix + (videos.length ? '<span class="on">' + videos.length + '</span>' : deepGet(t, 'tree.videosNone').split('— ')[1]);
    $('sbVideo').textContent = videos.length ? videos.length + t.row.videoSuffix : '';
    enableStart(videos.length > 0);
  }
  function refreshVideos() { aligned = false; renderVideos(); }
  async function addVideos() {
    const vs = await window.bruxo.pickVideo();
    if (vs) { vs.forEach(v => videos.push({ path: v, start: '', end: '', fps: '2', projection: 'flat' })); refreshVideos(); }
  }
  $('btnVideo').onclick = $('btnAddVideo').onclick = addVideos;

  // ── Modal de preview + corte (in/out) por timeline ─────────────────────────
  // Substitui a digitação manual de hh:mm:ss: abre o vídeo num player, mostra
  // uma barra de progresso com duas alças arrastáveis (início/fim) e escreve o
  // resultado de volta em videos[i].start/end no mesmo formato "hh:mm:ss" que
  // o ffmpeg já espera — o resto do pipeline não muda em nada.
  function toFileUrl(p) {
    let s = String(p).replace(/\\/g, '/');
    if (!s.startsWith('/')) s = '/' + s; // unidade Windows (C:/...) precisa da barra inicial
    return 'file://' + encodeURI(s);
  }
  function hmsToSec(str) {
    const p = String(str || '').split(':').map(x => parseInt(x, 10) || 0);
    if (!p.length || (p.length === 1 && !p[0])) return 0;
    if (p.length === 1) return p[0];
    if (p.length === 2) return p[0] * 60 + p[1];
    return p[0] * 3600 + p[1] * 60 + p[2];
  }
  function secToHms(sec) {
    sec = Math.max(0, Math.round(sec || 0));
    const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
    const pad = n => String(n).padStart(2, '0');
    return pad(h) + ':' + pad(m) + ':' + pad(s);
  }

  let trimIdx = -1, trimIn = 0, trimOut = 0, trimDuration = 0, trimDragging = null, trimLoopWatch = null;
  const trimVideo = () => $('trimVideo');
  const trimTrackEl = () => $('trimTrack');

  function trimPctFromSec(sec) { return trimDuration > 0 ? Math.min(100, Math.max(0, sec / trimDuration * 100)) : 0; }
  function trimSecFromClientX(clientX) {
    const rect = trimTrackEl().getBoundingClientRect();
    const pct = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
    return pct * trimDuration;
  }
  function renderTrimUI() {
    $('trimHandleIn').style.left = trimPctFromSec(trimIn) + '%';
    $('trimHandleOut').style.left = trimPctFromSec(trimOut) + '%';
    $('trimRange').style.left = trimPctFromSec(trimIn) + '%';
    $('trimRange').style.width = Math.max(0, trimPctFromSec(trimOut) - trimPctFromSec(trimIn)) + '%';
    $('trimInLabel').textContent = secToHms(trimIn);
    $('trimOutLabel').textContent = secToHms(trimOut);
    $('trimDuration').textContent = secToHms(trimDuration);
  }
  function renderTrimPlayhead() {
    const v = trimVideo();
    $('trimPlayhead').style.left = trimPctFromSec(v.currentTime || 0) + '%';
  }

  function openTrimModal(i) {
    const t = I18N[curLang] || I18N.pt;
    const v = videos[i];
    if (!v) return;
    trimIdx = i; trimDragging = null;
    $('trimTitle').textContent = v.path.split(/[\\\/]/).pop();
    $('trimNote').textContent = t.trim.note;
    $('trimCancel').textContent = t.trim.cancel;
    $('trimApply').textContent = t.trim.apply;
    $('trimPlay').textContent = '▶';
    const vid = trimVideo();
    vid.pause();
    vid.src = toFileUrl(v.path);
    vid.onloadedmetadata = () => {
      trimDuration = vid.duration || 0;
      trimIn = Math.min(hmsToSec(v.start), trimDuration);
      trimOut = v.end ? Math.min(hmsToSec(v.end), trimDuration) : trimDuration;
      if (trimOut <= trimIn) trimOut = trimDuration;
      vid.currentTime = trimIn;
      renderTrimUI(); renderTrimPlayhead();
    };
    vid.onerror = () => { log('⚠️ ' + t.trim.errNoVideo); };
    $('trimModal').classList.add('open');
  }
  function closeTrimModal() {
    const vid = trimVideo();
    vid.pause();
    vid.src = '';
    clearInterval(trimLoopWatch); trimLoopWatch = null;
    $('trimModal').classList.remove('open');
    trimIdx = -1;
  }
  $('trimCancel').onclick = closeTrimModal;
  $('trimModal').addEventListener('mousedown', e => { if (e.target === $('trimModal')) closeTrimModal(); });

  $('trimApply').onclick = () => {
    if (trimIdx < 0) return;
    const v = videos[trimIdx];
    v.start = trimIn > 0.4 ? secToHms(trimIn) : '';
    v.end = trimOut < trimDuration - 0.4 ? secToHms(trimOut) : '';
    aligned = false;
    closeTrimModal();
    renderVideos();
  };

  $('trimPlay').onclick = () => {
    const vid = trimVideo();
    if (vid.paused) { if (vid.currentTime < trimIn || vid.currentTime >= trimOut) vid.currentTime = trimIn; vid.play(); }
    else vid.pause();
  };
  trimVideo().addEventListener('play', () => {
    $('trimPlay').textContent = '⏸';
    clearInterval(trimLoopWatch);
    // Loop dentro do trecho marcado (in/out), pra pré-visualizar exatamente o
    // corte que vai ser usado — sem precisar exportar nada antes.
    trimLoopWatch = setInterval(() => {
      const vid = trimVideo();
      renderTrimPlayhead();
      if (vid.currentTime >= trimOut || vid.currentTime < trimIn - 0.5) vid.currentTime = trimIn;
    }, 80);
  });
  trimVideo().addEventListener('pause', () => { $('trimPlay').textContent = '▶'; clearInterval(trimLoopWatch); trimLoopWatch = null; });

  $('trimTrack').addEventListener('mousedown', e => {
    if (e.target.classList.contains('trimHandle')) return; // tratado abaixo
    trimVideo().currentTime = Math.min(trimOut, Math.max(trimIn, trimSecFromClientX(e.clientX)));
    renderTrimPlayhead();
  });
  ['trimHandleIn', 'trimHandleOut'].forEach(id => {
    $(id).addEventListener('mousedown', e => {
      e.stopPropagation();
      trimDragging = id === 'trimHandleIn' ? 'in' : 'out';
      $(id).classList.add('drag');
    });
  });
  window.addEventListener('mousemove', e => {
    if (!trimDragging) return;
    const sec = trimSecFromClientX(e.clientX);
    if (trimDragging === 'in') trimIn = Math.min(sec, trimOut - 0.2);
    else trimOut = Math.max(sec, trimIn + 0.2);
    trimIn = Math.max(0, trimIn); trimOut = Math.min(trimDuration, trimOut);
    renderTrimUI();
  });
  window.addEventListener('mouseup', () => {
    if (!trimDragging) return;
    document.querySelectorAll('.trimHandle').forEach(h => h.classList.remove('drag'));
    trimDragging = null;
  });

  $('btnOut').onclick = $('btnOut2').onclick = async () => {
    outDir = await window.bruxo.pickOutDir();
    if (outDir) $('outPath').textContent = outDir;
  };
  const opts = () => ({ videos, outDir, steps: $('steps').value === 'custom' ? Math.max(1000, +$('stepsCustom').value || 30000) : +$('steps').value, maxSize: +$('maxSize').value, dpvoMaxSize: +$('dpvoMaxSize').value, dpvoFov: +$('dpvoFov').value, lpips: +$('lpips').value, alignMethod: $('alignMethod').value, trainingEngine: $('trainingEngine').value, colmap: colmapOpts() });

  // Traduz o preset de alinhamento escolhido num objeto de parâmetros do COLMAP.
  // "auto" devolve null → o pipeline mantém o automatic_reconstructor de sempre.
  function colmapOpts() {
    const preset = $('colmapPreset').value;
    if (preset === 'auto') return null;
    if (preset === 'high') return { preset, features: 16384, peak: 0.003, matcher: 'sequential', guided: true, loop: false, affine: false, dsp: false, ba: true, minMatches: 15, triAngle: 1.5 };
    // "Máxima" liga loop detection: é o preset de quem aceita esperar, e sem ele
    // um vídeo que dá a volta nunca fecha o laço por melhor que seja o resto.
    if (preset === 'max') return { preset, features: 32768, peak: 0.002, matcher: 'sequential', guided: true, loop: true, affine: true, dsp: true, ba: true, minMatches: 15, triAngle: 1.5 };
    return { preset, features: +$('cmFeatures').value, peak: +$('cmPeak').value, matcher: $('cmMatcher').value,
      guided: $('cmGuided').checked, loop: $('cmLoop').checked, affine: $('cmAffine').checked, dsp: $('cmDsp').checked,
      ba: $('cmBA').checked, minMatches: +$('cmMinMatches').value, triAngle: +$('cmTriAngle').value };
  }
  const updateStepsCustomVisibility = () => {
    $('stepsCustom').style.display = $('steps').value === 'custom' ? 'block' : 'none';
  };
  $('steps').onchange = updateStepsCustomVisibility;

  // ── Recursos que exigem CUDA/NVIDIA ────────────────────────────────────────
  // No macOS não existe CUDA, e todos esses motores lançam erro explícito no
  // backend. Em vez de deixar o usuário escolher e só descobrir na hora do erro,
  // desabilitamos a opção e explicamos o porquê no próprio rótulo.
  function disableCudaOnlyFeatures() {
    if (!window.bruxo || window.bruxo.platform !== 'darwin') return;
    const en = curLang === 'en';
    const why = en ? ' — needs an NVIDIA GPU (unavailable on macOS)' : ' — requer GPU NVIDIA (indisponível no macOS)';

    // Selects: desabilita as opções e garante que a seleção atual não fique numa opção morta.
    const deadOptions = { trainingEngine: ['ppisp', '3dgrut', 'trianglesplat'], alignMethod: ['dpvo', 'mast3r', 'megasam'] };
    for (const [selectId, values] of Object.entries(deadOptions)) {
      const sel = $(selectId); if (!sel) continue;
      for (const v of values) {
        const opt = sel.querySelector(`option[value="${v}"]`);
        if (!opt) continue;
        opt.disabled = true;
        if (!opt.dataset.cudaNote) { opt.textContent += why; opt.dataset.cudaNote = '1'; }
      }
      if (values.includes(sel.value)) { sel.value = selectId === 'trainingEngine' ? 'brush' : 'colmap'; sel.dispatchEvent(new Event('change')); }
    }

    // Botões da aba IA. O SHARP é da própria Apple e roda no Mac, então fica de fora.
    const deadButtons = ['iaInstallTripo', 'iaRunTripo', 'iaInstallFace', 'iaRunFace', 'iaInstallZip', 'iaRunZipImage', 'iaRunZipVideo'];
    for (const id of deadButtons) {
      const b = $(id); if (!b) continue;
      b.disabled = true;
      b.title = (en ? 'Unavailable on macOS: requires an NVIDIA GPU with CUDA.' : 'Indisponível no macOS: requer GPU NVIDIA com CUDA.');
    }
  }
  disableCudaOnlyFeatures();
  window.__disableCudaOnlyFeatures = disableCudaOnlyFeatures;

  // ── Ferramentas do macOS (Homebrew + ffmpeg + COLMAP) ──────────────────────
  async function checarFerramentasMac() {
    const box = $('macToolsBox');
    if (!box || !window.bruxo?.macToolsStatus) return;
    if (window.bruxo.platform !== 'darwin') { box.style.display = 'none'; return; }
    let st;
    try { st = await window.bruxo.macToolsStatus(); } catch { return; }
    const en = curLang === 'en';
    if (!st || !st.needed) {
      box.style.display = 'none';
      return;
    }
    box.style.display = '';
    const faltam = (st.faltando && st.faltando.length) ? st.faltando.join(', ') : (en ? 'ffmpeg, colmap' : 'ffmpeg, colmap');
    $('macToolsMsg').textContent = st.temBrew
      ? (en ? 'Missing: ' + faltam + '. Homebrew is already installed.'
            : 'Faltando: ' + faltam + '. O Homebrew já está instalado.')
      : (en ? 'Homebrew is not installed — it is needed to install ' + faltam + ' (these have no official Mac build).'
            : 'O Homebrew não está instalado — ele é necessário para instalar ' + faltam + ' (essas ferramentas não têm build oficial para Mac).');
  }
  $('macToolsBtn')?.addEventListener('click', async () => {
    const r = await window.bruxo.macToolsInstall();
    const en = curLang === 'en';
    if (r?.ok) {
      log(en ? '🖥 Terminal opened. Confirm there (it may ask for your password), then click "Check again".'
             : '🖥 Terminal aberto. Confirme por lá (pode pedir sua senha) e depois clique em "Verificar de novo".');
    } else {
      // Se o Terminal não abrir, ainda dá pra copiar o comando do log.
      log((en ? '❌ Could not open Terminal: ' : '❌ Não consegui abrir o Terminal: ') + (r?.error || '?'));
      if (r?.comando) log((en ? 'Run this manually in the Terminal:\n' : 'Rode isto manualmente no Terminal:\n') + r.comando);
    }
  });
  $('macToolsRecheck')?.addEventListener('click', async () => {
    await checarFerramentasMac();
    const st = await window.bruxo.macToolsStatus();
    const en = curLang === 'en';
    log(st?.needed ? (en ? '⏳ Still missing tools — did the Terminal finish?' : '⏳ Ainda faltam ferramentas — o Terminal já terminou?')
                   : (en ? '✅ All macOS tools are installed.' : '✅ Todas as ferramentas do macOS estão instaladas.'));
  });
  checarFerramentasMac();
  const updateColmapCustomVisibility = () => {
    $('cmCustomBox').style.display = $('colmapPreset').value === 'custom' ? 'block' : 'none';
  };
  $('colmapPreset').onchange = updateColmapCustomVisibility;
  updateColmapCustomVisibility();
  const updateTrainingEngineHint = () => {
    const engine = $('trainingEngine').value;
    const isEn = curLang === 'en';
    const hint = engine === '3dgrut'
      ? (isEn
        ? '3DGRUT runs the NVIDIA 3DGRT ray-tracing backend. It needs an RTX/NVIDIA GPU, CUDA Toolkit and Visual Studio Build Tools. Its own uv environment is installed only on first use; PLY opens in the editor and USDZ is saved beside it.'
        : '3DGRUT usa o backend 3DGRT de ray tracing da NVIDIA. Requer GPU RTX/NVIDIA, CUDA Toolkit e Visual Studio Build Tools. O ambiente uv próprio é instalado somente na primeira vez; o PLY abre no editor e o USDZ é salvo ao lado dele.')
      : (I18N[curLang] || I18N.pt).params.ppispHint;
    $('trainingEngineHint').textContent = engine === 'brush'
      ? (isEn ? 'Brush is the compatible default engine and does not install an experimental NVIDIA environment.' : 'Brush é o motor compatível padrão e não instala um ambiente NVIDIA experimental.')
      : hint;
  };
  $('trainingEngine').onchange = updateTrainingEngineHint;
  const begin = () => {
    running = true; enableStart(false);
    logLines = []; $('log').textContent = ''; order.forEach(s => setStage(s, ''));
    resetLossChart();
    $('statusOverlay').style.display = 'block';
    $('btnAbort').disabled = false;
    $('viewer').style.display = 'none'; $('glcanvas').style.display = 'block';
    $('sbState').textContent = I18N[curLang].msg.processing;
  };
  $('btnAlign').onclick = () => { if (!running && videos.length) { begin(); window.bruxo.align(opts()); } };
  $('btnColmap').onclick = () => window.bruxo.openColmap();
  const start = () => { if (!running && videos.length) { begin(); window.bruxo.train({ ...opts(), forceAlign: !aligned }); } };
  $('btnStart').onclick = $('btnStart2').onclick = start;
  $('btnSaveProject').onclick = async () => {
    const r = await window.bruxo.saveProject();
    if (r && r.ok) log((curLang === 'en' ? '💾 Project saved: ' : '💾 Projeto salvo: ') + r.path);
  };
  $('btnOpenProject').onclick = () => window.bruxo.openProject();
  $('btnAbort').onclick = async () => {
    if (!running) return;
    $('btnAbort').disabled = true;
    const en = curLang === 'en';
    $('stageLine').textContent = en ? 'Abort requested — stopping the current process…' : 'Abortamento solicitado — encerrando o processo atual…';
    const r = await window.bruxo.abortWork();
    if (!r || !r.ok) {
      $('btnAbort').disabled = false;
      log((en ? '⚠ Nothing active to abort yet.' : '⚠ Ainda não há um processo ativo para abortar.'));
    }
  };
  $('btnFolder').onclick = () => lastPly && window.bruxo.openFolder(lastPly);
  let lastViewerUrl = null;
  $('tMove').onclick = () => window.setEditMode('move');
  $('tRotY').onclick = () => window.setEditMode('rot');
  $('tScale').onclick = () => window.setEditMode('scale');
  $('tSel').onclick = () => window.setEditMode('select');
  $('tDel').onclick = () => window.edDelete();
  $('tCrop').onclick = () => window.edCrop();
  $('tCenter').onclick = () => window.edCenter();
  $('tClean').onclick = () => {
    const n = window.edClean(+$('edOpac').value);
    const m = I18N[curLang].msg;
    log(m.cleanLog1 + n + m.cleanLog2 + $('edOpac').value + m.cleanLog3);
  };
  $('edScale').oninput = () => window.edScale(Math.pow(10, +$('edScale').value));
  $('tSave').onclick = async () => {
    const buf = await window.edSave();
    if (!buf) return;
    const r = await window.bruxo.savePly(buf, undefined, window.__edLastXform); // main.js gera BruxoSplat_0001.ply, _0002.ply...
    lastPly = r.path; lastViewerUrl = r.viewerUrl; lastCameraPathUrl = r.cameraPath || lastCameraPathUrl;
    $('sbPly').textContent = r.path.split(/[\\\/]/).pop();
    log(I18N[curLang].msg.savedFileLog + r.path);
  };
  const showWeb = (url, which) => {
    $('glcanvas').style.display = 'none'; $('vpBadge').style.display = 'none';
    $('timeline4d').style.display = 'none'; // some com a timeline 4D pra não ficar por cima do WebEDIT/SuperSplat
    if (t4dPlaying) stopTimeline4d();
    const v = $('viewer'); v.style.display = 'block';
    // força recarregar mesmo se o destino for o mesmo de antes (evita ficar "preso" numa aba)
    v.src = 'about:blank';
    setTimeout(() => { v.src = url; }, 0);
    $('btnBackEd').style.display = 'inline-block';
    $('btnWebTop').classList.toggle('sel', which === 'webedit');
    $('btnSuper').classList.toggle('sel', which === 'super');
  };
  $('btnBackEd').onclick = () => {
    const v = $('viewer'); v.style.display = 'none'; v.src = 'about:blank';
    $('glcanvas').style.display = 'block'; $('vpBadge').style.display = 'block';
    $('btnBackEd').style.display = 'none';
    $('btnWebTop').classList.remove('sel'); $('btnSuper').classList.remove('sel');
    if (seq4d) $('timeline4d').style.display = 'flex'; // volta a timeline 4D ao retornar pro visualizador interno
  };
  // aplica as edições atuais (centro, rotação, exclusões…) num .ply, só quando algo mudou de fato
  let exportedUrl = null;
  async function syncEdits() {
    if (!window.edSave) return lastViewerUrl;
    if (!window.edDirty && exportedUrl) return exportedUrl; // nada mudou: reusa o último export
    const m = I18N[curLang].msg;
    try {
      const buf = await window.edSave();
      if (buf) {
        const r = await window.bruxo.savePly(buf, 'splat_view.ply', window.__edLastXform); // nome fixo: sobrescreve, não acumula arquivos
        lastPly = r.path; lastViewerUrl = r.viewerUrl; exportedUrl = r.viewerUrl;
        window.edDirty = false;
        log(m.editsAppliedLog + r.path.split(/[\\\/]/).pop());
      }
    } catch (e) { log(m.editsWarn1 + e.message + m.editsWarn2); }
    return exportedUrl || lastViewerUrl;
  }
  $('btnSuper').onclick = async () => {
    const u = await syncEdits();
    if (!u) { log(I18N[curLang].msg.generateFirst); return; }
    const raw = u.split('url=')[1];
    // o SuperSplat detecta o formato pela extensão no fim da string; um "?t=timestamp" solto quebra isso.
    // então o cache-bust vai como valor de query, mas a string continua terminando em ".ply".
    const cacheBusted = raw + (raw.includes('?') ? '&' : '?') + 'v=' + Date.now() + '.ply';
    showWeb('https://superspl.at/editor?load=' + encodeURIComponent(cacheBusted), 'super');
  };
  // WebEDIT (o site) já aceita .ply/.splat/.ksplat/.splat4d direto — diferente do editor interno (só .ply)
  // e do SuperSplat (deixamos travado em .ply por segurança). Pra formatos não-ply/sequência 4D, manda
  // o frame/arquivo atual sem passar pelo syncEdits (que exige ed.obj, só existe pro editor de pontos).
  function currentRawSplatUrl() {
    if (seq4d) return { url: seq4d.base + '/seq4d/' + t4dIdx, format: seq4d.formats[t4dIdx] };
    if (window.currentRawUrl) return { url: window.currentRawUrl, format: window.currentFileFormat };
    return null;
  }
  // O sidecar .camera.json acompanha o splat até o WebEDIT, sem alterar o PLY.
  const withCameraPath = url => !lastCameraPathUrl ? url : url + (url.includes('?') ? '&' : '?') + 'camera=' + encodeURIComponent(lastCameraPathUrl);
  const openWebEdit = async () => {
    // nada importado ainda: abre o diálogo de importação direto e, assim que escolher o arquivo,
    // manda pro WebEDIT sem passar por nenhuma outra tela.
    if (!seq4d && !lastViewerUrl && !window.currentRawUrl) {
      const r = await window.bruxo.openPly();
      if (!r) return;
      const ok = await loadPickedPly(r);
      if (!ok) return;
      return openWebEdit();
    }
    // sequência 4D (mesmo com frames .ply, tipo o SHARP 4D) nunca passou pelo editor de pontos —
    // então precisa do caminho "bruto", igual .splat/.ksplat avulso; só um .ply único de verdade
    // (aberto/gerado normalmente) tem ed.obj carregado e pode usar o syncEdits.
    // sequência 4D: manda TODOS os frames pro WebEDIT via ?seq= (suporte injetado pelo servidor), pra
    // ele abrir como sequência/timeline — não só um frame.
    if (seq4d) {
      const v = Date.now();
      const urls = [];
      for (let i = 0; i < seq4d.count; i++) urls.push(encodeURIComponent(seq4d.base + '/seq4d/' + i + '?v=' + v));
      const fmts = seq4d.formats.join(',');
      showWeb(withCameraPath(seq4d.base + '/webedit/index.html?seq=' + urls.join(',') + '&fmt=' + fmts), 'webedit');
      return;
    }
    if (window.currentFileFormat !== 'ply') {
      const raw = currentRawSplatUrl();
      if (!raw) { log(I18N[curLang].msg.generateFirst); return; }
      // mesmo truque do SuperSplat: cache-bust como valor de query, mantendo a string terminada na extensão real
      const busted = raw.url + (raw.url.includes('?') ? '&' : '?') + 'v=' + Date.now() + '.' + raw.format;
      // faltava isso: tem que abrir a PÁGINA do webedit com esse arquivo como parâmetro — mandar o
      // iframe direto pro arquivo bruto faz o navegador tentar baixá-lo (daí o "salvar como") em vez
      // de renderizar dentro do visualizador.
      const base = lastViewerUrl.split('/webedit/')[0];
      showWeb(withCameraPath(base + '/webedit/index.html?url=' + busted), 'webedit');
      return;
    }
    const u = await syncEdits(); if (u) showWeb(withCameraPath(u + '&t=' + Date.now()), 'webedit');
  };
  const setModeBtns = m => {
    ['mPoints','mGS','mMesh'].forEach(id => $(id).classList.remove('sel'));
    $(m).classList.add('sel');
  };
  $('mPoints').onclick = () => { setModeBtns('mPoints'); window.setViewMode('points'); };
  // Estilo da nuvem (Nuvem/Anéis/Centros/Depth) e projeção Perspectiva/Ortográfica
  $('vizSel')?.addEventListener('change', e => window.setPointStyle(+e.target.value));
  let projOrtho = false;
  $('btnProj')?.addEventListener('click', () => { projOrtho = !projOrtho; window.setProjection(projOrtho ? 'ortho' : 'persp'); });
  $('mGS').onclick = async () => {
    const u = await syncEdits();
    const m = I18N[curLang].msg;
    if (!u) { log(m.generateFirst); return; }
    setModeBtns('mGS');
    log(m.loadingGS);
    try { await window.setViewMode('gs', u.split('url=')[1] + '?t=' + Date.now()); log(m.gsActive); }
    catch (e) { log(m.gsError + e.message); setModeBtns('mPoints'); window.setViewMode('points'); }
  };
  async function generateMesh() {
    const m = I18N[curLang].msg;
    log(m.buildingMesh);
    try {
      const ok = await window.buildMesh(+$('meshRes').value, +$('meshDensity').value);
      if (!ok) { log(m.meshEmpty); setModeBtns('mPoints'); window.setViewMode('points'); return; }
      await window.setViewMode('mesh');
      log(m.meshReady);
    } catch (e) { log(m.meshError + e.message); setModeBtns('mPoints'); window.setViewMode('points'); }
  }
  $('mMesh').onclick = async () => {
    if (!window.buildMesh) return;
    setModeBtns('mMesh');
    await generateMesh();
  };
  $('meshRes').addEventListener('change', () => { if ($('mMesh').classList.contains('sel')) generateMesh(); });
  $('meshDensity').addEventListener('change', () => { if ($('mMesh').classList.contains('sel')) generateMesh(); });
  $('tWeb').onclick = openWebEdit;
  $('btnWebTop').onclick = openWebEdit;
  // gizmo (mover/girar/escalar/selecionar/excluir/crop/centralizar/limpar/salvar/WebEDIT) só funciona
  // no editor de pontos — que hoje só existe pra .ply. Em .splat/.ksplat/4D fica só visualização.
  // tWeb/btnWebTop ficam fora dessa lista: abrir no WebEDIT não depende do editor de pontos (ver openWebEdit)
  const GIZMO_TOOL_IDS = ['tMove','tRotY','tScale','tSel','tDel','tCrop','tCenter','tClean','tSave'];
  function setGizmoEnabled(v) { GIZMO_TOOL_IDS.forEach(id => { const el = $(id); if (el) el.disabled = !v; }); }

  // ══════════ Sequência 4D (timeline) — .ply/.splat/.ksplat por frame, importados de uma pasta ══════════
  let seq4d = null; // { base, names, formats, count }
  let t4dTimer = null, t4dPlaying = false, t4dIdx = 0, t4dBusy = false, t4dCacheGen = 0;
  let t4dGpuViewer = null; // modo GPU: um DropInViewer com TODOS os frames pré-carregados na GPU
  // pré-carrega TODOS os frames em memória (blob: URL) antes de liberar o play — a rede/disco não pode
  // mais entrar no caminho crítico da reprodução, senão nunca fica em tempo real. Fica pesado em memória
  // pra sequências muito longas/densas, mas é o preço de tocar sem engasgo.
  let t4dCache = new Map(); // idx -> blobUrl
  function t4dCacheClear() {
    for (const u of t4dCache.values()) if (u) URL.revokeObjectURL(u); t4dCache.clear(); t4dCacheGen++;
    // descarta o viewer GPU (todos os frames) se existir — evita render duplicado e libera memória
    if (t4dGpuViewer) { const v = t4dGpuViewer; t4dGpuViewer = null; try { scene.remove(v); } catch {} v.dispose && v.dispose(); }
  }
  // MODO GPU: sobe todos os frames pra GPU de uma vez (um DropInViewer com enableOptionalEffects) e depois
  // só alterna a visibilidade de cada cena — play fica instantâneo, ao custo de muita memória de vídeo.
  async function t4dPreloadGPU() {
    const gen = t4dCacheGen;
    $('t4dPlay').disabled = true;
    const GS3D = await import('@mkkellogg/gaussian-splats-3d');
    if (gsViewer) { scene.remove(gsViewer); gsViewer.dispose && gsViewer.dispose(); gsViewer = null; }
    if (ed.flip) ed.flip.visible = false;
    if (ptsObj) ptsObj.visible = false;
    if (meshObj) meshObj.visible = false;
    gsMode = true; meshMode = false;
    const v = new GS3D.DropInViewer({ gpuAcceleratedSort: false, sharedMemoryForWorkers: false,
      enableOptionalEffects: true, sceneRevealMode: GS3D.SceneRevealMode.Instant });
    v.rotation.x = Math.PI;
    const fmtMap = GS_FORMAT_MAP(GS3D);
    for (let i = 0; i < seq4d.count; i++) {
      if (gen !== t4dCacheGen) { try { await v.dispose(); } catch {} return; } // sequência trocou no meio
      const fmt = fmtMap[seq4d.formats[i]] ?? GS3D.SceneFormat.Ply;
      try {
        await v.addSplatScene(seq4d.base + '/seq4d/' + i, { showLoadingUI: false, format: fmt, sceneRevealMode: GS3D.SceneRevealMode.Instant });
        const sc = v.getSplatScene(v.getSceneCount() - 1); if (sc) sc.visible = (i === 0);
      } catch (e) { log('⚠ frame ' + (i + 1) + ': ' + e.message); }
      $('t4dCount').textContent = 'GPU ' + (i + 1) + '/' + seq4d.count;
    }
    if (gen !== t4dCacheGen) { try { await v.dispose(); } catch {} return; }
    t4dGpuViewer = v; scene.add(v);
    t4dIdx = 0; $('t4dScrub').value = 0;
    $('t4dPlay').disabled = false;
    $('t4dCount').textContent = '1/' + seq4d.count;
    log(I18N[curLang].msg.seq4dCached.replace('{n}', seq4d.count));
  }
  async function t4dPrefetch(i, gen) {
    if (!seq4d || t4dCache.has(i)) return;
    t4dCache.set(i, null); // marca "em andamento" pra não pedir duas vezes
    try {
      const buf = await (await fetch(seq4d.base + '/seq4d/' + i)).arrayBuffer();
      if (gen !== t4dCacheGen) return; // sequência trocou enquanto isso baixava — descarta
      t4dCache.set(i, URL.createObjectURL(new Blob([buf], { type: 'application/octet-stream' })));
    } catch { t4dCache.delete(i); }
  }
  // baixa a sequência inteira com um pequeno grau de paralelismo, mostrando progresso na timeline;
  // só libera o ▶ quando 100% estiver em cache (scrub manual continua funcionando antes disso).
  async function t4dPrefetchAll() {
    const gen = t4dCacheGen;
    $('t4dPlay').disabled = true;
    // arquivos locais (servidos pelo http local) aguentam bem mais paralelismo que download de rede
    const CONCURRENCY = 8;
    let done = 0, next = 0;
    const total = seq4d.count;
    async function worker() {
      while (next < total) {
        const i = next++;
        await t4dPrefetch(i, gen);
        if (gen !== t4dCacheGen) return;
        done++;
        $('t4dCount').textContent = 'cache ' + done + '/' + total;
      }
    }
    await Promise.all(Array.from({ length: Math.min(CONCURRENCY, total) }, worker));
    if (gen !== t4dCacheGen) return; // sequência mudou no meio do caminho
    $('t4dPlay').disabled = false;
    $('t4dCount').textContent = (t4dIdx + 1) + '/' + total;
    log(I18N[curLang].msg.seq4dCached.replace('{n}', total));
  }
  function stopTimeline4d() { clearTimeout(t4dTimer); t4dTimer = null; t4dPlaying = false; $('t4dPlay').textContent = '▶'; }
  async function showFrame4d(i) {
    if (!seq4d) return;
    // MODO GPU: só liga a cena do frame e desliga as outras — instantâneo, sem recarregar nada
    if (t4dGpuViewer) {
      t4dIdx = ((i % seq4d.count) + seq4d.count) % seq4d.count;
      $('t4dScrub').value = t4dIdx;
      const n = t4dGpuViewer.getSceneCount();
      for (let k = 0; k < n; k++) { const sc = t4dGpuViewer.getSplatScene(k); if (sc) sc.visible = (k === t4dIdx); }
      if (!$('t4dPlay').disabled) $('t4dCount').textContent = (t4dIdx + 1) + '/' + seq4d.count;
      return;
    }
    if (t4dBusy) return; // modo stream: cada frame recarrega do disco — se ainda tá carregando, não empilha
    t4dBusy = true;
    t4dIdx = ((i % seq4d.count) + seq4d.count) % seq4d.count;
    $('t4dScrub').value = t4dIdx;
    if ($('t4dPlay').disabled) $('t4dCount').textContent = 'cache ' + t4dCache.size + '/' + seq4d.count;
    else $('t4dCount').textContent = (t4dIdx + 1) + '/' + seq4d.count;
    const cached = t4dCache.get(t4dIdx);
    const url = cached || (seq4d.base + '/seq4d/' + t4dIdx + '?t=' + Date.now());
    try { await window.setViewMode('gs', url, seq4d.formats[t4dIdx]); }
    catch (e) { log('⚠ frame ' + (t4dIdx + 1) + ': ' + e.message); }
    t4dBusy = false;
  }
  async function load4DSequence(r) {
    stopTimeline4d();
    t4dCacheClear();
    seq4d = { base: r.base, names: r.names, formats: r.formats, count: r.count };
    window.currentFileFormat = r.formats[0] || 'ply';
    $('mPoints').disabled = true; $('mMesh').disabled = true; $('btnWebTop').disabled = false; $('btnSuper').disabled = true;
    window.currentRawUrl = null; // usa seq4d/t4dIdx em vez disso — ver currentRawSplatUrl()
    setGizmoEnabled(false);
    $('mGS').disabled = false; setModeBtns('mGS');
    $('t4dScrub').max = String(seq4d.count - 1);
    $('timeline4d').style.display = 'flex';
    $('placeholder').style.display = 'none';
    log(I18N[curLang].msg.seq4dLoaded.replace('{n}', seq4d.count));
    if ($('t4dMode').value === 'gpu') {
      await t4dPreloadGPU();            // sobe tudo pra GPU (play instantâneo depois)
    } else {
      await showFrame4d(0);             // stream: mostra o 1º frame e vai pré-baixando o resto em blob
      t4dPrefetchAll();
    }
  }
  $('t4dPlay').onclick = () => {
    if (!seq4d) return;
    if (t4dPlaying) { stopTimeline4d(); return; }
    t4dPlaying = true; $('t4dPlay').textContent = '⏸';
    // agenda o próximo frame só depois que o atual terminou de carregar de verdade — cada frame
    // é lido do disco e decodificado do zero, então um setInterval fixo empilhava chamadas e travava tudo
    const loop = async () => {
      if (!t4dPlaying) return;
      const t0 = Date.now();
      await showFrame4d(t4dIdx + 1);
      const fps = Math.max(1, Math.min(60, +$('t4dFps').value || 12));
      const wait = Math.max(0, 1000 / fps - (Date.now() - t0));
      if (t4dPlaying) t4dTimer = setTimeout(loop, wait);
    };
    loop();
  };
  $('t4dScrub').oninput = () => { stopTimeline4d(); showFrame4d(+$('t4dScrub').value); };
  $('t4dFps').onchange = () => { if (t4dPlaying) { stopTimeline4d(); $('t4dPlay').click(); } };
  // troca stream ⇄ GPU: recarrega a sequência atual no novo modo pra comparar desempenho
  $('t4dMode').onchange = async () => {
    if (!seq4d) return;
    stopTimeline4d();
    await load4DSequence({ base: seq4d.base, names: seq4d.names, formats: seq4d.formats, count: seq4d.count });
  };
  // converte a sequência .ply atual pra .splat (~4x menor, abre e toca bem mais rápido) e recarrega
  $('t4dConvert').onclick = async () => {
    if (!seq4d) return;
    stopTimeline4d();
    $('t4dConvert').disabled = true;
    log(I18N[curLang].msg.iaMode);
    try {
      const r = await window.bruxo.convertSeqSplat();
      if (!r) return;
      if (r.error) { log('⚠ ' + r.error); return; }
      await load4DSequence(r);
    } finally { $('t4dConvert').disabled = false; }
  };
  $('t4dExportSeq').onclick = async () => {
    const r = await window.bruxo.exportSeq4d();
    if (!r) return;
    if (r.error) { log('⚠ ' + r.error); return; }
    log(I18N[curLang].msg.seq4dExported.replace('{n}', r.count) + r.dir);
  };
  $('t4dExportPack').onclick = async () => {
    stopTimeline4d();
    log(I18N[curLang].msg.iaMode); // reaproveita o texto genérico "processando" enquanto o encode roda
    const r = await window.bruxo.exportSplat4d();
    if (!r) return;
    if (r.error) { log('⚠ ' + r.error); return; }
    log(I18N[curLang].msg.splat4dExported + r.path);
  };
  const iaRun = async (key, pick) => {
    const input = await pick();
    if (!input) return;
    $('statusOverlay').style.display = 'block';
    $('sbState').textContent = I18N[curLang].msg.iaMode;
    window.bruxo.modelRun(key, input);
  };
  $('iaInstallSharp').onclick = () => { $('statusOverlay').style.display='block'; window.bruxo.modelInstall('sharp'); };
  $('iaInstallTripo').onclick = () => { $('statusOverlay').style.display='block'; window.bruxo.modelInstall('triposplat'); };
  $('iaInstallZip').onclick = () => { $('statusOverlay').style.display='block'; window.bruxo.modelInstall('zipsplat'); };
  $('iaRunZipImage').onclick = () => iaRun('zipsplat', window.bruxo.pickImage);
  $('iaRunZipVideo').onclick = () => iaRun('zipsplat', async () => { const v = await window.bruxo.pickVideo(); return v && v[0]; });
  $('iaRunSharp').onclick = () => iaRun('sharp', window.bruxo.pickImage);
  $('iaRunTripo').onclick = () => iaRun('triposplat', window.bruxo.pickImage);
  $('iaRunSharp4d').onclick = async () => {
    const vs = await window.bruxo.pickVideo();
    if (!vs || !vs.length) return;
    $('statusOverlay').style.display = 'block';
    $('sbState').textContent = I18N[curLang].msg.sharp4dMode;
    const fps = Math.max(1, Math.min(60, +$('s4dFps').value || 10));
    window.bruxo.sharp4d(vs[0], 1 / fps); // o backend ainda espera o intervalo em segundos (1/fps)
  };
  $('iaInstallFace').onclick = () => { $('statusOverlay').style.display='block'; window.bruxo.modelInstall('faceanything'); };
  $('iaRunFace').onclick = async () => {
    const vs = await window.bruxo.pickVideo();
    if (!vs || !vs.length) return;
    $('statusOverlay').style.display = 'block';
    $('sbState').textContent = I18N[curLang].msg.face4dMode;
    window.bruxo.faceAnything4d(vs[0], $('faceMaxFrames').value);
  };
  window.addEventListener('keydown', e => {
    if (e.key === 'Delete') window.edDelete();
    if (e.key === 'Escape') window.setEditMode(null);
    if (e.key === 'F2') window.setView('top');
    if (e.key === 'F3') window.setView('right');
    if (e.key === 'F4') window.setView('front');
    if (e.ctrlKey && e.key.toLowerCase() === 'z') { e.shiftKey ? window.edRedo() : window.edUndo(); }
  });
  $('viewSel').onchange = () => { if ($('viewSel').value !== 'free') window.setView($('viewSel').value); };
  $('pbPlay').onclick = () => { window.stopCameraPath(); window.setOrbit(true); };
  $('pbCamPath').onclick = () => window.playCameraPath();
  $('pbStop').onclick = () => { window.setOrbit(false); window.stopCameraPath(); };
  $('pbSlow').onclick = () => window.orbitFaster(0.7);
  $('pbFast').onclick = () => window.orbitFaster(1.4);
  // move controles do viewport para a barra fixa (fora do view)
  $('slotBack').appendChild($('btnBackEd'));
  $('slotView').appendChild($('viewSel'));
  $('slotPlay').appendChild($('playbar'));
  $('slotMode').appendChild($('modeSel'));
  // carrega um arquivo já escolhido pelo diálogo do sistema (window.bruxo.openPly()) — usado tanto pelo
  // menu Arquivo > Abrir quanto pelo botão do WebEDIT quando nada foi importado ainda.
  async function loadPickedPly(r) {
    if (!r) return false;
    stopTimeline4d(); t4dCacheClear(); seq4d = null;
    $('timeline4d').style.display = 'none';
    lastViewerUrl = r.viewerUrl; lastCameraPathUrl = r.cameraPath || null; $('viewer').style.display='none'; $('glcanvas').style.display='block';
    window.currentFileFormat = r.format || 'ply';
    const editable = window.currentFileFormat === 'ply';
    $('mPoints').disabled = !editable; $('mMesh').disabled = !editable;
    $('btnFolder').disabled = false; $('btnWebTop').disabled = false; // WebEDIT aceita .ply/.splat/.ksplat direto
    $('btnSuper').disabled = !editable; // SuperSplat continua limitado a .ply exportado do editor
    setGizmoEnabled(editable);
    if (editable) {
      window.currentRawUrl = null;
      await window.loadEditor(r.viewerUrl.split('url=')[1]);
      await window.loadCameraPath(r.cameraPath);
      setModeBtns('mPoints');
    } else {
      const sceneUrl = r.viewerUrl.split('url=')[1];
      window.currentRawUrl = sceneUrl;
      await window.setViewMode('gs', sceneUrl + '?t=' + Date.now(), window.currentFileFormat);
      setModeBtns('mGS');
      log(I18N[curLang].msg.viewOnlyFormat.replace('{fmt}', window.currentFileFormat.toUpperCase()));
    }
    log(I18N[curLang].msg.openedLog + r.path);
    return true;
  }
  window.bruxo.onMenu(async a => {
    if (a === 'new') location.reload();
    if (a === 'open') { await loadPickedPly(await window.bruxo.openPly()); }
    if (a === 'open4d') {
      const r = await window.bruxo.pick4DFolder();
      if (!r) return;
      if (r.error) { log(r.error); return; }
      await load4DSequence(r);
    }
    if (a === 'save') $('tSave').click();
    if (a === 'savecompact') { $('edCompact').checked = true; $('tSave').click(); }
    if (a === 'import') $('btnVideo').click();
    if (a === 'undo') window.edUndo();
    if (a === 'redo') window.edRedo();
    if (a === 'delete') window.edDelete();
    if (a === 'crop') window.edCrop();
    if (a === 'center') window.edCenter();
    if (a === 'clean') $('tClean').click();
  });

  // toggles do viewport
  const syncToggles = () => { window.setPtsVisible($('cbPoints').checked); window.setCamsVisible($('cbCams').checked); };
  $('cbPoints').onchange = $('cbCams').onchange = syncToggles;
  $('tglPoints').onclick = () => { $('cbPoints').checked = !$('cbPoints').checked; syncToggles(); };
  $('tglCams').onclick = () => { $('cbCams').checked = !$('cbCams').checked; syncToggles(); };
  $('btnResetCam').onclick = () => window.resetView();

  // Item 4 (roadmap jul/2026): gráfico de loss em tempo real. O treino (PPISP e, se o
  // Brush algum dia expuser, também ele) já manda cada linha de stdout via onStatus com
  // stage:'train' — aqui só extraímos o "loss=" da linha e desenhamos um sparkline simples,
  // sem precisar de nenhuma lib de gráfico.
  const lossHistory = [];
  const LOSS_MAX_POINTS = 400;
  function resetLossChart() {
    lossHistory.length = 0;
    $('lossChart').style.display = 'none';
    $('lossChartLabel').style.display = 'none';
  }
  function drawLossChart() {
    const canvas = $('lossChart');
    const ctx = canvas.getContext('2d');
    const w = canvas.width, h = canvas.height;
    ctx.clearRect(0, 0, w, h);
    if (lossHistory.length < 2) return;
    const min = Math.min(...lossHistory), max = Math.max(...lossHistory);
    const range = Math.max(max - min, 1e-6);
    ctx.beginPath();
    lossHistory.forEach((v, i) => {
      const x = (i / (lossHistory.length - 1)) * (w - 4) + 2;
      const y = h - 4 - ((v - min) / range) * (h - 8);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    const grad = ctx.createLinearGradient(0, 0, w, 0);
    grad.addColorStop(0, '#8b5cf6'); grad.addColorStop(1, '#22c55e');
    ctx.strokeStyle = grad; ctx.lineWidth = 1.5; ctx.stroke();
    $('lossChartFirst').textContent = 'loss ' + lossHistory[0].toFixed(4);
    $('lossChartLast').textContent = lossHistory[lossHistory.length - 1].toFixed(4);
  }
  function pushLossFromLine(line) {
    const m = /loss=([\d.]+)/.exec(line || '');
    if (!m) return;
    const v = parseFloat(m[1]);
    if (!isFinite(v)) return;
    lossHistory.push(v);
    if (lossHistory.length > LOSS_MAX_POINTS) lossHistory.shift();
    $('lossChart').style.display = 'block';
    $('lossChartLabel').style.display = 'flex';
    drawLossChart();
  }
  // Etapas longas sem barra própria (alinhamento de câmeras via COLMAP/MegaSam/DPVO/MASt3R)
  // costumavam deixar a UI com a barra travada em 0% e o texto parado, dando impressão de
  // travamento mesmo com o log mostrando progresso real (ex.: "100%|##########| 784/784").
  // Agora: (a) só zera a barra quando a ETAPA muda (não a cada linha sem número), (b) um
  // indicador "●" pulsante + contador de segundos desde a última linha prova que o processo
  // continua vivo mesmo quando não há porcentagem pra mostrar.
  let lastStatusStage = null, lastStatusAt = Date.now();
  window.bruxo.onStatus(d => {
    const i = order.indexOf(d.stage);
    order.forEach((s, j) => setStage(s, j < i ? 'done' : j === i ? 'active' : ''));
    $('stageLabel').textContent = I18N[curLang].stage[d.stage] || d.stage;
    $('stageLine').textContent = d.line;
    if (d.stage !== lastStatusStage) { lastStatusStage = d.stage; $('obarIn').style.width = '0'; $('stagePct').textContent = ''; }
    if (d.prog != null) { $('obarIn').style.width = (d.prog*100)+'%'; $('stagePct').textContent = (d.prog*100).toFixed(0)+'%'; }
    lastStatusAt = Date.now();
    if (d.stage === 'train') pushLossFromLine(d.line);
    log(d.line, d.line.startsWith('Baixando'));
  });
  setInterval(() => {
    const hb = $('stageHeartbeat');
    if (!hb || $('statusOverlay').style.display === 'none') return;
    const secs = Math.floor((Date.now() - lastStatusAt) / 1000);
    const en = curLang === 'en';
    hb.textContent = secs < 15 ? '●' : (en ? `● still working (${secs}s, normal for this step)` : `● ainda processando (${secs}s, normal nessa etapa)`);
    hb.title = en ? 'The process keeps running in the background; some internal steps (model loading, bundle adjustment) print nothing for a while.'
                  : 'O processo continua rodando em segundo plano; algumas etapas internas (carregamento de modelo, ajuste de feixe) ficam sem imprimir nada por um tempo.';
  }, 1000);
  let snapBusy = false;
  window.bruxo.onTrainSnap(async d => {
    $('obarIn').style.width = (d.prog * 100) + '%';
    $('stagePct').textContent = (d.prog * 100).toFixed(0) + '%';
    lastStatusAt = Date.now();
    if (snapBusy) return;
    snapBusy = true;
    try {
      await window.loadEditor(d.url);
      const m = I18N[curLang].msg;
      $('vpBadge').textContent = m.trainingPartial1 + (d.prog * 100).toFixed(0) + m.trainingPartial2;
    } catch (e) {} finally { snapBusy = false; }
  });
  window.bruxo.onPreview(d => {
    log(I18N[curLang].msg.previewLog);
    lastCameraPathUrl = d.cameraPath || null;
    window.showPreview(d.points, d.cameras);
  });
  window.bruxo.onProjectOpened(async d => {
    lastCameraPathUrl = d.cameraPath || null;
    aligned = true; $('btnColmap').disabled = false; enableStart(true);
    if (d.points) await window.showPreview(d.points, d.cameras);
    if (d.ply) {
      lastPly = d.ply; lastViewerUrl = d.viewerUrl;
      $('sbPly').textContent = d.ply.split(/[\\/]/).pop(); $('btnFolder').disabled = false; $('btnWebTop').disabled = false;
      window.currentFileFormat = 'ply'; setGizmoEnabled(true);
      await window.loadEditor(d.viewerUrl.split('url=')[1]);
      await window.loadCameraPath(d.cameraPath);
      setModeBtns('mPoints');
    } else if (d.cameraPath) await window.loadCameraPath(d.cameraPath);
    log((curLang === 'en' ? '📂 Project opened: ' : '📂 Projeto aberto: ') + d.path);
  });
  window.bruxo.onAligned(() => {
    $('btnColmap').disabled = false;
    running = false; enableStart(true); aligned = true;
    ['setup','frames','colmap'].forEach(s => setStage(s, 'done'));
    $('statusOverlay').style.display = 'none';
    $('btnAbort').disabled = true;
    $('sbState').textContent = I18N[curLang].msg.readyToTrain;
    log(I18N[curLang].msg.alignedLog);
  });
  window.bruxo.onDone(async d => {
    running = false; enableStart(true);
    order.forEach(s => setStage(s, 'done'));
    lastPly = d.ply;
    lastCameraPathUrl = d.cameraPath || null;
    const name = d.ply.split(/[\\\/]/).pop();
    $('tSplat').innerHTML = I18N[curLang].tree.splatPrefix + '<span class="on">' + name + '</span>';
    $('sbPly').textContent = name; $('sbState').textContent = I18N[curLang].msg.ready2;
    $('btnFolder').disabled = false; $('btnSuper').disabled = false; $('btnWebTop').disabled = false;
    $('statusOverlay').style.display = 'none';
    $('btnAbort').disabled = true;
    $('placeholder').style.display = 'none';
    // um resultado novo (SHARP, TripoSplat, pipeline normal…) é sempre um .ply único — se antes você
    // estava numa sequência 4D ou em modo GS, precisa voltar pro editor de pontos, senão o gizmo não
    // funciona (ele só edita ed.obj/ptsObj, que ficam escondidos atrás do modo GS/timeline anterior).
    stopTimeline4d(); t4dCacheClear(); $('timeline4d').style.display = 'none';
    window.currentFileFormat = 'ply';
    $('mPoints').disabled = false; $('mMesh').disabled = false;
    setGizmoEnabled(true);
    lastViewerUrl = d.viewerUrl;
    await window.loadEditor(d.viewerUrl.split('url=')[1]);
    await window.loadCameraPath(lastCameraPathUrl);
    window.setViewMode('points');
    setModeBtns('mPoints');
    log(I18N[curLang].msg.savedAtLog + d.ply);
    log(I18N[curLang].msg.editorActiveLog);
  });
  window.bruxo.onDone4d(async d => {
    // um modo de IA (ex: FaceAnything) terminou de gerar uma sequência de frames — carrega direto na timeline
    running = false; enableStart(true);
    $('statusOverlay').style.display = 'none';
    $('btnAbort').disabled = true;
    await load4DSequence(d);
  });
  window.bruxo.onError(d => {
    running = false; enableStart(true);
    $('sbState').textContent = I18N[curLang].msg.errorPill;
    $('statusOverlay').style.display = 'none';
    $('btnAbort').disabled = true;
    log(I18N[curLang].msg.errorLog + d.message);
    document.querySelector('[data-t="log"]').click();
  });
  window.bruxo.onCancelled(() => {
    running = false; enableStart(true);
    $('statusOverlay').style.display = 'none'; $('btnAbort').disabled = true;
    const en = curLang === 'en';
    $('sbState').textContent = en ? 'Cancelled' : 'Cancelado';
    log(en ? '⏹ Processing cancelled. Existing frames, alignment and partial checkpoints were kept.' : '⏹ Processamento cancelado. Frames, alinhamento e checkpoints parciais existentes foram preservados.');
    document.querySelector('[data-t="log"]').click();
  });

  (async () => {
    let saved = 'pt';
    try { saved = localStorage.getItem('bruxoLang') || 'pt'; } catch (e) {}
    if (window.bruxo && window.bruxo.getLang) { try { saved = (await window.bruxo.getLang()) || saved; } catch (e) {} }
    translate(saved);
    if (window.bruxo && window.bruxo.getVersion) {
      try {
        const v = await window.bruxo.getVersion();
        if (v) { $('appVersion').textContent = 'v' + v; document.title = 'BruxoSplat v' + v; }
      } catch (e) {}
    }
  })();
</script>
</body>
</html>
